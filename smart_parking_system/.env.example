# Flask Application Configuration
SECRET_KEY=smart-parking-secure-secret-key-replace-in-production
FLASK_ENV=development
DEBUG=True
PORT=5000

# Database Configuration
# Default: SQLite file in instance/smart_parking.db
# For PostgreSQL deployment: postgresql://username:password@localhost:5432/smart_parking_db
DATABASE_URL=sqlite:///instance/smart_parking.db

# Initial Admin Setup (Seeded only on first database initialization)
ADMIN_NAME=Pournami
ADMIN_MOBILE=8106479530
ADMIN_EMAIL=admin@smartparking.com
ADMIN_PASSWORD=Admin@12345

# Parking Rate (INR per billable hour)
HOURLY_RATE=30.00

# Razorpay Payment Gateway (Test Mode / Production)
# Leave empty to enable the clearly-labelled Local Development Payment Simulator
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Twilio SMS Service
# Leave empty to enable the local notification log & development simulator
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

